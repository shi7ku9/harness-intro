#!/usr/bin/env bash
# codex-intro — Play the woven-logo animation before starting OpenAI Codex.
#   Press any key to skip; Ctrl-C cancels startup.
#   CODEX_NO_INTRO=1 disables the animation; CODEX_INTRO_SPEED=2 plays at 2x speed.
#   Uses Unicode Braille art of the ChatGPT mark; no image protocol required.

[[ -t 0 && -t 1 && -z ${CODEX_NO_INTRO:-} ]] || exit 0
[[ -n ${TERM:-} && $TERM != dumb ]] || exit 0
intro_locale=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
[[ ${intro_locale,,} == *utf*8* ]] || exit 0

# Codex 0.167.2 centers a 60x21 stage in the whole terminal, reserving
# three header rows and six composer/footer rows. Narrow windows scale
# by width only; a stage that cannot fit is hidden rather than clipped.
measure_stage() {
  read -r ROWS COLS < <(stty size 2>/dev/null)
  [[ $ROWS =~ ^[0-9]+$ && $COLS =~ ^[0-9]+$ ]] || return 1
  STAGE_WIDTH=$(( COLS < 64 ? COLS - 4 : 60 ))
  STAGE_HEIGHT=$(( STAGE_WIDTH * 21 / 60 ))
  STAGE_TOP=$(( (ROWS - STAGE_HEIGHT) / 2 ))
  (( STAGE_HEIGHT >= 14 && STAGE_TOP >= 3 &&
     STAGE_TOP + STAGE_HEIGHT <= ROWS - 6 ))
}
measure_stage || exit 0

RESET=$'\e[0m'
BOLD=$'\e[1m'
if [[ -n ${NO_COLOR:-} ]]; then
  WHITE=$'\e[39m'
  TEAL=$'\e[39m'
  SOFT=$'\e[39m'
  DIM=$'\e[2m'
elif [[ ${COLORTERM:-} == truecolor || ${COLORTERM:-} == 24bit ]]; then
  WHITE=$'\e[38;2;235;244;240m'
  TEAL=$'\e[38;2;65;207;168m'
  SOFT=$'\e[38;2;174;222;206m'
  DIM=$'\e[38;2;136;150;146m'
else
  WHITE=$'\e[38;5;255m'
  TEAL=$'\e[38;5;79m'
  SOFT=$'\e[38;5;152m'
  DIM=$'\e[38;5;245m'
fi

SPEED=${CODEX_INTRO_SPEED:-1}
[[ $SPEED =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || SPEED=1

# Precompute all frame delays once to avoid spawning awk on every frame.
read -r FRAME_DELAY PULSE_DELAY TYPE_DELAY HOLD_DELAY < <(
  LC_ALL=C awk -v speed="$SPEED" 'BEGIN {
    if (!(speed > 0)) speed = 1
    split("0.035 0.09 0.025 0.48", delay)
    for (i = 1; i <= 4; i++) {
      t = delay[i] / speed
      printf "%.4f%s", (t < 0.001 ? 0.001 : t), (i == 4 ? "\n" : " ")
    }
  }'
)
[[ -n $HOLD_DELAY ]] || exit 0

