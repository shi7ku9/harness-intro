TITLE='OpenAI Codex'
HINT='press any key to skip'
ORIGINAL_SUB=$PWD
[[ $ORIGINAL_SUB == "$HOME" ]] && ORIGINAL_SUB='~'
[[ $ORIGINAL_SUB == "$HOME/"* ]] && ORIGINAL_SUB="~/${ORIGINAL_SUB#"$HOME/"}"
ORIGINAL_SUB=${ORIGINAL_SUB//[[:cntrl:]]/}

prepare_layout() {
  local row col stage glyph phase color last_color frame position
  load_art
  BASE=$(( STAGE_TOP + ART_Y + 1 ))
  LEFT=$(( (COLS - STAGE_WIDTH) / 2 + ART_X + 1 ))
  TITLE_ROW=$(( BASE + ART_HEIGHT + 1 ))
  TITLE_COL=$(( (COLS - ${#TITLE}) / 2 + 1 ))
  HINT_ROW=$(( TITLE_ROW + 3 ))
  HINT_COL=$(( (COLS - ${#HINT}) / 2 + 1 ))
  SUB=$ORIGINAL_SUB
  SUB_WIDTH=$(printf '%s' "$SUB" | wc -L)
  if (( SUB_WIDTH > COLS - 6 )); then
    SUB=${SUB: -$(( COLS - 7 ))}
    while (( $(printf '%s' "$SUB" | wc -L) > COLS - 7 )); do
      SUB=${SUB:1}
    done
    SUB="…$SUB"
    SUB_WIDTH=$(printf '%s' "$SUB" | wc -L)
  fi
  SUB_COL=$(( (COLS - SUB_WIDTH) / 2 + 1 ))

  # Derive the clockwise reveal from the current stage, so every native
  # size gets the same 24-step animation without resampling Braille cells.
  mapfile -t PHASES < <(LC_ALL=C awk -v w="$ART_WIDTH" -v h="$ART_HEIGHT" 'BEGIN {
    pi = atan2(0, -1)
    alphabet = "abcdefghijklmnopqrstuvwx"
    for (r = 0; r < h; r++) {
      for (c = 0; c < w; c++) {
        angle = atan2(c + 0.5 - w / 2, (h / 2 - r - 0.5) * 2)
        if (angle < 0) angle += 2 * pi
        printf "%s", substr(alphabet, int(angle / (2 * pi) * 24) + 1, 1)
      }
      printf "\n"
    }
  }')
  FRAMES=()
  for (( stage = 0; stage < 24; stage++ )); do
    frame=$'\e[?2026h'
    for (( row = 0; row < ART_HEIGHT; row++ )); do
      printf -v position '\e[%d;%dH' "$((BASE + row))" "$LEFT"
      frame+=$position
      last_color=''
      for (( col = 0; col < ART_WIDTH; col++ )); do
        glyph=${ART[row]:col:1}
        phase=${PHASES[row]:col:1}
        if [[ $glyph == ' ' ]] || (( phase_index[$phase] > stage )); then
          frame+=' '
        else
          color=$WHITE
          (( stage - phase_index[$phase] < 4 )) && color=$TEAL
          if [[ $color != "$last_color" ]]; then
            frame+=$color
            last_color=$color
          fi
          frame+=$glyph
        fi
      done
    done
    FRAMES+=("$frame$RESET"$'\e[?2026l')
  done
}

declare -A phase_index
alphabet=abcdefghijklmnopqrstuvwx
for (( i = 0; i < 24; i++ )); do
  phase_index[${alphabet:i:1}]=$i
done

OLD_STTY=$(stty -g 2>/dev/null) || exit 0
screen_active=0
resize_pending=0
cleanup() {
  stty "$OLD_STTY" 2>/dev/null
  (( screen_active )) && printf '%s' $'\e[?2026l\e[0m\e[?25h\e[?1049l'
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'resize_pending=1' WINCH

stty -echo -icanon min 1 time 0 2>/dev/null || exit 0
screen_active=1
printf '%s' $'\e[?1049h\e[?25l\e[2J'

current_stage=0
current_color=''
title_length=0
sub_visible=0

draw_complete() {
  local row out=$'\e[?2026h' position
  for (( row = 0; row < ART_HEIGHT; row++ )); do
    printf -v position '\e[%d;%dH' "$((BASE + row))" "$LEFT"
    out+="$position$1${ART[row]}"
  done
  printf '%s' "$out$RESET"$'\e[?2026l'
}

refresh_layout() {
  # A resize can arrive during frame preparation. Recheck before emitting
  # coordinates, avoiding stale frames and terminal scrolling while dragging.
  while :; do
    resize_pending=0
    measure_stage || exit 0
    prepare_layout
    (( resize_pending )) || break
  done
  printf '%s' $'\e[?2026h\e[2J'
  printf '\e[%d;%dH%s%s%s' "$HINT_ROW" "$HINT_COL" "$DIM" "$HINT" "$RESET"
  if (( title_length )); then
    printf '\e[%d;%dH%s%s%s' "$TITLE_ROW" "$TITLE_COL" "$BOLD$WHITE" "${TITLE:0:title_length}" "$RESET"
  fi
  if (( sub_visible )); then
    printf '\e[%d;%dH%s%s%s' "$((TITLE_ROW + 1))" "$SUB_COL" "$DIM" "$SUB" "$RESET"
  fi
  if [[ -n $current_color ]]; then
    draw_complete "$current_color"
  else
    printf '%s' "${FRAMES[current_stage]}"
  fi
}

pause() {
  local key prefix rest i
  if IFS= read -rsn1 -t "$1" key; then
    # Drain arrow-key escape sequences so leftover bytes do not leak into Codex.
    if [[ $key == $'\e' ]]; then
      if IFS= read -rsn1 -t 0.008 prefix && [[ $prefix == '[' || $prefix == O ]]; then
        for (( i = 0; i < 16; i++ )); do
          IFS= read -rsn1 -t 0.008 rest || break
          [[ $rest == [a-zA-Z~] ]] && break
        done
      fi
    fi
    exit 0
  fi
  (( resize_pending )) && refresh_layout
  return 0
}

refresh_layout
for (( current_stage = 0; current_stage < 24; current_stage++ )); do
  printf '%s' "${FRAMES[current_stage]}"
  pause "$FRAME_DELAY"
done
current_stage=23

for current_color in "$WHITE" "$SOFT" "$WHITE"; do
  draw_complete "$current_color"
  pause "$PULSE_DELAY"
done

for (( title_length = 1; title_length <= ${#TITLE}; title_length++ )); do
  printf '\e[%d;%dH%s%s%s' "$TITLE_ROW" "$TITLE_COL" "$BOLD$WHITE" "${TITLE:0:title_length}" "$RESET"
  pause "$TYPE_DELAY"
done

sub_visible=1
printf '\e[%d;%dH%s%s%s' "$((TITLE_ROW + 1))" "$SUB_COL" "$DIM" "$SUB" "$RESET"
pause "$HOLD_DELAY"

exit 0
