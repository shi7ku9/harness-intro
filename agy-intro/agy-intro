#!/usr/bin/env bash
# agy-intro — Play the Antigravity icon animation before starting Antigravity CLI.
#   Press any key to skip; Ctrl-C cancels startup.
#   AGY_NO_INTRO=1 disables the animation; AGY_INTRO_SPEED=2 plays at 2x speed.
#   Uses Unicode Braille art; no image protocol required.

[[ -t 0 && -t 1 && -z ${AGY_NO_INTRO:-} ]] || exit 0
[[ -n ${TERM:-} && $TERM != dumb ]] || exit 0
intro_locale=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
[[ ${intro_locale,,} == *utf*8* ]] || exit 0

read -r ROWS COLS < <(stty size 2>/dev/null)
[[ $ROWS =~ ^[0-9]+$ && $COLS =~ ^[0-9]+$ ]] || exit 0
(( ROWS >= 21 && COLS >= 36 )) || exit 0

RESET=$'\e[0m'
BOLD=$'\e[1m'
if [[ -n ${NO_COLOR:-} ]]; then
  WHITE=$'\e[39m'
  DIM=$'\e[2m'
  COLOR_MODE=none
elif [[ ${COLORTERM:-} == truecolor || ${COLORTERM:-} == 24bit ]]; then
  WHITE=$'\e[38;2;232;240;254m'
  DIM=$'\e[38;2;134;144;162m'
  COLOR_MODE=truecolor
else
  WHITE=$'\e[38;5;255m'
  DIM=$'\e[38;5;245m'
  COLOR_MODE=256
fi

SPEED=${AGY_INTRO_SPEED:-1}
[[ $SPEED =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || SPEED=1

# Precompute all frame delays once to avoid spawning awk on every frame.
read -r FRAME_DELAY SETTLE_DELAY TYPE_DELAY HOLD_DELAY < <(
  LC_ALL=C awk -v speed="$SPEED" 'BEGIN {
    if (!(speed > 0)) speed = 1
    split("0.032 0.11 0.025 0.48", delay)
    for (i = 1; i <= 4; i++) {
      t = delay[i] / speed
      printf "%.4f%s", (t < 0.001 ? 0.001 : t), (i == 4 ? "\n" : " ")
    }
  }'
)
[[ -n $HOLD_DELAY ]] || exit 0

ART=(
  '                            '
  '          ⢀⣴⣾⣿⣿⣷⣦⡀          '
  '         ⣰⣿⣿⣿⣿⣿⣿⣿⣿⣆         '
  '        ⢠⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣆        '
  '       ⢀⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡀       '
  '       ⣼⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣧       '
  '      ⢠⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡆      '
  '      ⣼⣿⣿⣿⣿⡿⠟⠛⠛⠻⢿⣿⣿⣿⣿⣷      '
  '     ⢰⣿⣿⣿⡿⠋      ⠈⢿⣿⣿⣿⣇     '
  '    ⢀⣿⣿⣿⡟⠁         ⢻⣿⣿⣿⡄    '
  '   ⢀⣾⣿⣿⠟            ⠹⣿⣿⣿⡄   '
  '  ⣠⣿⣿⡿⠋              ⠘⢿⣿⣿⣆  '
  ' ⢾⣿⠿⠋                  ⠙⠻⣿⡷ '
  '                            '
)

# Palette keys matching the Antigravity icon gradient (blue legs -> green/violet slopes -> orange/coral apex).
COLORS=(
  '                            '
  '          31024577          '
  '         9668acdb77         '
  '        ffhhmonkigee        '
  '       llqruzzAxtspjj       '
  '       rrwCEIIGGFDyvs       '
  '      wwCEIKKKKKJGFDBB      '
  '      CEIKKKKKKKKJJJHH      '
  '     EIIKKK      KKJJJJ     '
  '    IIKKKK         KKJJJ    '
  '   KKKKK            KKKKK   '
  '  KKKKK              KKKKK  '
  ' KKKK                  KKKK '
  '                            '
)

# Reveal phases a-x sweep upward from both legs, bridge the arch, and ignite the apex.
PHASES=(
  '                            '
  '          wxxxxxxw          '
  '         uvvvvvvvvu         '
  '        ssttttttttss        '
  '       qqrrrrrrrrrrqq       '
  '       oppppppppppppo       '
  '      mmnnnnnoonnnnnmm      '
  '      kllllllmmllllllk      '
  '     iijjjj      jjjjii     '
  '    gghhhh         hhhgg    '
  '   eefff            fffee   '
  '  cccdd              ddccc  '
  ' aaab                  baaa '
  '                            '
)

declare -A COLOR_MAP GLOW_MAP
while read -r key r g b gr gg gb c256 g256; do
  [[ -z $key ]] && continue
  case $COLOR_MODE in
    none)
      COLOR_MAP[$key]=$'\e[39m'
      GLOW_MAP[$key]=$'\e[39m'
      ;;
    truecolor)
      COLOR_MAP[$key]=$'\e[38;2;'"$r;$g;$b"'m'
      GLOW_MAP[$key]=$'\e[38;2;'"$gr;$gg;$gb"'m'
      ;;
    256)
      COLOR_MAP[$key]=$'\e[38;5;'"$c256"'m'
      GLOW_MAP[$key]=$'\e[38;5;'"$g256"'m'
      ;;
  esac
done <<'EOF'
0 236 159 36 243 193 113 214 215
1 228 175 37 237 203 113 178 221
2 240 140 40 245 180 115 208 215
3 213 186 44 228 210 118 178 186
4 241 123 46 246 169 119 208 216
5 243 107 51 247 159 122 203 216
6 186 182 62 210 208 130 143 186
7 240 88 63 245 146 130 203 210
8 195 160 66 216 193 132 143 180
9 167 195 68 198 216 133 143 186
a 202 144 70 221 183 135 173 180
b 229 99 70 238 154 135 167 210
c 210 128 72 226 172 136 173 180
d 220 113 72 232 163 136 167 180
e 222 84 87 234 144 146 167 174
f 125 193 94 170 215 150 107 150
g 207 95 98 224 151 153 167 174
h 121 174 106 168 202 158 107 151
i 190 106 110 213 158 161 131 181
j 198 92 120 218 149 167 168 175
k 171 118 121 200 166 168 138 181
l 90 186 122 148 210 169 72 115
m 127 156 122 172 191 169 108 249
n 154 130 127 189 174 172 245 249
o 138 143 128 179 182 172 102 249
p 181 97 133 207 152 176 132 175
q 81 177 136 142 204 178 72 115
r 71 171 155 135 200 190 72 115
