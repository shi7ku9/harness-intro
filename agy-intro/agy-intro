K 51 135 252 122 177 253 69 111
EOF

BASE=$(( (ROWS - 19) / 2 + 1 ))
LEFT=$(( (COLS - 28) / 2 + 1 ))
TITLE='Antigravity CLI'
HINT='press any key to skip'
TITLE_ROW=$(( BASE + 15 ))
TITLE_COL=$(( (COLS - ${#TITLE}) / 2 + 1 ))

SUB=$PWD
[[ $SUB == "$HOME" ]] && SUB='~'
[[ $SUB == "$HOME/"* ]] && SUB="~/${SUB#"$HOME/"}"
SUB=${SUB//[[:cntrl:]]/}
# Use GNU wc -L for accurate terminal display width on multibyte paths.
SUB_WIDTH=$(printf '%s' "$SUB" | wc -L)
if (( SUB_WIDTH > COLS - 6 )); then
  SUB=${SUB: -$(( COLS - 7 ))}
  while (( $(printf '%s' "$SUB" | wc -L) > COLS - 7 )); do
    SUB=${SUB:1}
  done
  SUB="…$SUB"
  SUB_WIDTH=$(printf '%s' "$SUB" | wc -L)
fi
SUB_COL=$(( (COLS - SUB_WIDTH) / 2 + 1 ))

declare -A phase_index
alphabet=abcdefghijklmnopqrstuvwx
for (( i = 0; i < 24; i++ )); do
  phase_index[${alphabet:i:1}]=$i
done

# build_frame <base_row> <stage> <mode>
# Populates FRAME_BUF; mode is sweep (luminous edge) or rest (true gradient).
build_frame() {
  local base_row=$1 stage=$2 mode=$3
  local row col position last_color glyph phase ckey color out=$'\e[?2026h'

  for (( row = 0; row < 14; row++ )); do
    printf -v position '\e[%d;%dH' "$((base_row + row))" "$LEFT"
    out+=$position
    last_color=''
    for (( col = 0; col < 28; col++ )); do
      glyph=${ART[row]:col:1}
      phase=${PHASES[row]:col:1}
      if [[ $phase == ' ' ]] || (( stage >= 0 && phase_index[$phase] > stage )); then
        out+=' '
      else
        ckey=${COLORS[row]:col:1}
        if [[ $mode == sweep && $(( stage - phase_index[$phase] )) -lt 3 ]]; then
          color=${GLOW_MAP[$ckey]:-$WHITE}
        else
          color=${COLOR_MAP[$ckey]:-$WHITE}
        fi
        if [[ $color != "$last_color" ]]; then
          out+=$color
          last_color=$color
        fi
        out+=$glyph
      fi
    done
  done
  FRAME_BUF="$out$RESET"$'\e[?2026l'
}

# Pre-render all frames so playback emits one write per frame without flicker.
FRAMES=()
for (( stage = 0; stage < 24; stage++ )); do
  build_frame "$BASE" "$stage" sweep
  FRAMES+=("$FRAME_BUF")
done
build_frame "$BASE" -1 rest
REST_FRAME=$FRAME_BUF

OLD_STTY=$(stty -g 2>/dev/null) || exit 0
screen_active=0
cleanup() {
  stty "$OLD_STTY" 2>/dev/null
  (( screen_active )) && printf '%s' $'\e[?2026l\e[0m\e[?25h\e[?1049l'
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'exit 0' WINCH

stty -echo -icanon min 1 time 0 2>/dev/null || exit 0
screen_active=1
printf '%s' $'\e[?1049h\e[?25l\e[2J'

pause() {
  local key prefix rest i
  if IFS= read -rsn1 -t "$1" key; then
    # Drain arrow-key escape sequences so leftover bytes do not leak into agy.
    if [[ $key == $'\e' ]]; then
      if IFS= read -rsn1 -t 0.008 prefix && [[ $prefix == '[' || $prefix == O ]]; then
        for (( i = 0; i < 16; i++ )); do
          IFS= read -rsn1 -t 0.008 rest || break
          [[ $rest == [a-zA-Z~] ]] && break
        done
      fi
    fi
    exit 0
  fi
}

printf '\e[%d;%dH%s%s%s' "$(( BASE + 18 ))" "$(( (COLS - ${#HINT}) / 2 + 1 ))" "$DIM" "$HINT" "$RESET"
for frame in "${FRAMES[@]}"; do
  printf '%s' "$frame"
  pause "$FRAME_DELAY"
done

# Settle the luminous sweep edge into the true gradient in place.
printf '%s' "$REST_FRAME"
pause "$SETTLE_DELAY"

for (( i = 1; i <= ${#TITLE}; i++ )); do
  printf '\e[%d;%dH%s%s%s' "$TITLE_ROW" "$TITLE_COL" "$BOLD$WHITE" "${TITLE:0:i}" "$RESET"
  pause "$TYPE_DELAY"
done

printf '\e[%d;%dH%s%s%s' "$((TITLE_ROW + 1))" "$SUB_COL" "$DIM" "$SUB" "$RESET"
pause "$HOLD_DELAY"

exit 0
